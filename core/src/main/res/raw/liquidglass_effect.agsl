uniform shader content;
uniform float2 size;
uniform float2 offset;
uniform float4 cornerRadii;
// The thick slab's rounded edge: how far in from the rim it reaches (px). Inside it the glass is flat.
uniform float refractionHeight;
// How far the slab's edge bends what's behind it at the rim (px): positive samples outward (draws what lies
// just beyond the edge in toward the rim; the drawable records a margin for it), negative inward.
uniform float refractionAmount;
// The edge's height profile: a squircle h(t) = (1 - (1 - t)^k)^(1/k) over the band (t = 0 at the rim, 1
// where it meets the flat top); 2 = a quarter circle, 4 = a squircle (a flatter top, a steeper rim).
uniform float profile;
// How much the bend leans toward the centre's direction (rounds the bend's field at the corners).
uniform float depthEffect;
// The colour split, as a share of the bend at the rim (narrowing inward faster than the bend): red is
// sampled that much further out, blue that much further in (0 = one sample, no split).
uniform float chromaticAberration;

uniform float contrast;
// Toward white (> 0) or black (< 0), 0-1: the glass's own lift.
uniform float whitePoint;
// Saturation (linear light): > 1 the frosted picture behind reads richer, as Apple's glass does.
uniform float chromaMultiplier;
// Adaptive tone: the picture's lightness is pulled toward tone (sRGB lightness, 0-1), by adapt.x where it
// is darker (the glass lightens over dark pictures) and adapt.y where it is lighter (darkens over bright).
uniform float tone;
uniform float2 adapt;

uniform float3 tintColor;
uniform float tintAlpha;
// Light: a thin rim line (rimLight, rimWidth px), an edge brightening a little wider (fresnel, fresnelWidth
// px) and a soft glow across the band from the lit side (rimGlow), all strongest on the edges facing
// lightDir, oppositeLight times that on the edges facing away, dim at right angles.
uniform float rimLight;
uniform float rimWidth;
uniform float2 lightDir;
uniform float oppositeLight;
uniform float fresnel;
uniform float fresnelWidth;
uniform float rimGlow;
// Opacity; outside the rounded shape the result is transparent (anti-aliased edge), so a drawable needs
// no clip.
uniform float alpha;

const half3 rgbToY = half3(0.2126, 0.7152, 0.0722);

float radiusAt(float2 coord, float4 radii) {
    if (coord.x >= 0.0) {
        if (coord.y <= 0.0) return radii.y;
        else return radii.z;
    } else {
        if (coord.y <= 0.0) return radii.x;
        else return radii.w;
    }
}

float sdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    float outside = length(max(cornerCoord, 0.0)) - radius;
    float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
    return outside + inside;
}

float safeSign(float value) {
    return value < 0.0 ? -1.0 : 1.0;
}

float2 safeNormalize(float2 value, float2 fallback) {
    float len = length(value);
    if (len > 0.001) {
        return value / len;
    }
    return fallback;
}

float2 gradSdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    if (cornerCoord.x >= 0.0 || cornerCoord.y >= 0.0) {
        float2 outside = max(cornerCoord, 0.0);
        float outsideLength = length(outside);
        if (outsideLength > 0.001) {
            return sign(coord) * (outside / outsideLength);
        }
        float useX = step(cornerCoord.y, cornerCoord.x);
        return float2(
            useX * safeSign(coord.x),
            (1.0 - useX) * safeSign(coord.y)
        );
    } else {
        float gradX = step(cornerCoord.y, cornerCoord.x);
        return sign(coord) * float2(gradX, 1.0 - gradX);
    }
}

// A smooth bump over [-0.8, 0.8]: one colour's share of the split.
half spectral(float x) {
    float u = clamp(1.0 - (x * x) / 0.64, 0.0, 1.0);
    return half(u * u);
}

half3 colour(half3 c) {
    // Saturation in linear light (gamma 2: close to sRGB's curve, and no pow per pixel), then the adaptive
    // tone, the lift, the tint and contrast.
    half3 lin = c * c;
    float yl = dot(lin, rgbToY);
    c = sqrt(max(mix(half3(yl), lin, chromaMultiplier), half3(0.0)));
    float ys = dot(c, rgbToY);
    float pull = ys < tone ? adapt.x : adapt.y;
    c += half3((tone - ys) * pull);
    float3 target = (whitePoint > 0.0) ? float3(1.0) : float3(0.0);
    c = mix(c, target, abs(whitePoint));
    c = mix(c, tintColor, tintAlpha);
    return (c - 0.5) * (1.0 + contrast) + 0.5;
}

half4 main(float2 coord) {
    float2 halfSize = size * 0.5;
    float2 centeredCoord = (coord + offset) - halfSize;
    float radius = radiusAt(centeredCoord, cornerRadii);

    float sdRaw = sdRoundedRect(centeredCoord, halfSize, radius);
    // Outside the shape (the margin recorded for outward refraction): clear, nothing to sample.
    if (sdRaw >= 0.5) return half4(0.0);
    float dIn = max(-sdRaw, 0.0);
    float band = max(refractionHeight, 1.0);
    float t = clamp(dIn / band, 0.0, 1.0);
    // The flat top beyond the band and the light: the picture as it is, coloured (most of the pixels).
    if (t >= 1.0 && dIn >= max(rimWidth, fresnelWidth)) {
        half4 top = content.eval(coord);
        float mf = clamp(0.5 - sdRaw, 0.0, 1.0) * alpha;
        return half4(colour(top.rgb) * mf, top.a * mf);
    }

    float smoothRadius = max(radius * 1.5, 30.0);
    float gradRadius = min(smoothRadius, min(halfSize.x, halfSize.y));
    float2 shapeGrad = gradSdRoundedRect(centeredCoord, halfSize, gradRadius);

    half4 color;
    if (t >= 1.0) {
        color = content.eval(coord);
    } else {
        // The slab's height across its rounded edge; the bend is steepest at the rim, none on the flat top.
        float hgt = pow(1.0 - pow(1.0 - t, profile), 1.0 / profile);
        float d = refractionAmount * (1.0 - hgt);
        float2 depthGrad = safeNormalize(centeredCoord, shapeGrad);
        float2 grad = safeNormalize(shapeGrad + depthEffect * depthGrad, shapeGrad);
        float2 refractedCoord = coord + d * grad;
        float x = 1.0 - t;
        float splitLen = d * chromaticAberration * x * x * x;
        // No split, or under half a pixel (most of the band, as it narrows fast): one sample.
        if (abs(splitLen) < 0.5) {
            color = content.eval(refractedCoord);
        } else {
            // The colour split runs along the bend (the edge's normal) in proportion to it, narrowing toward
            // the inside faster than the bend ((1 - t)^3): a fringe that hugs the rim. Twelve taps with
            // smooth, overlapping spectral weights spread a sharp line into a smooth fringe; the taps also
            // spread along the edge (as far as the split is long, in a shuffled order), so small details
            // beyond the edge, which the bend stretches into streaks, blur together instead of each turning
            // into its own rainbow.
            float2 split = grad * splitLen;
            float2 along = float2(-grad.y, grad.x) * splitLen;
            half3 acc = half3(0.0);
            half3 wsum = half3(0.0);
            half a = 0.0;
            for (int i = 0; i < 12; i++) {
                float tt = (float(i) + 0.5) / 6.0 - 1.0;
                float u = fract(float(i) * 0.5833 + 0.04) * 2.0 - 1.0;
                half4 s = content.eval(refractedCoord + split * tt + along * u);
                half3 w = half3(spectral(tt - 0.55), spectral(tt), spectral(tt + 0.55));
                acc += s.rgb * w;
                wsum += w;
                a += s.a;
            }
            color = half4(acc / wsum, a / 12.0);
        }
    }

    half3 c = colour(color.rgb);
    float facing = dot(shapeGrad, lightDir);
    float lobe = 0.2 + 0.8 * (pow(max(facing, 0.0), 1.5) + oppositeLight * pow(max(-facing, 0.0), 1.5));
    float rimV = rimLight * (1.0 - clamp(dIn / max(rimWidth, 0.5), 0.0, 1.0));
    float f = 1.0 - clamp(dIn / max(fresnelWidth, 1.0), 0.0, 1.0);
    float light = (rimV + fresnel * f * f) * lobe + rimGlow * (1.0 - t) * (1.0 - t) * max(facing, 0.0);
    c = clamp(c + (1.0 - c) * clamp(light, 0.0, 1.0), 0.0, 1.0);

    float m = clamp(0.5 - sdRaw, 0.0, 1.0) * alpha;
    return half4(c * m, color.a * m);
}
