uniform shader content;
uniform float2 size;
uniform float2 offset;
uniform float4 cornerRadii;
uniform float refractionHeight;
// The band's bend (px): negative samples inward (magnifies what's under the band), positive samples outward
// (draws what lies just beyond the edge in toward the rim; the drawable records a margin for it).
uniform float refractionAmount;
uniform float depthEffect;
// The colour split, as a share of the bend at the rim (narrowing inward faster than the bend): red is
// sampled that much further out, blue that much further in (0 = one sample, no split).
uniform float chromaticAberration;

uniform float contrast;
uniform float whitePoint;
uniform float chromaMultiplier;

uniform float3 tintColor;
uniform float tintAlpha;
// Rim light along the edges facing lightDir (and, fainter, the opposite ones), rimWidth px wide; 0 = none.
uniform float rimLight;
uniform float rimWidth;
uniform float2 lightDir;
// 0 = the circular profile (strong at the very edge, short); 1 = a long, smooth falloff (smootherstep:
// the bend and its magnification both fade to zero where the band meets the flat centre, no line).
uniform float bandSoftness;
// A soft glow of the rim light reaching across the band, fading to zero at its inner end (0 = none).
uniform float rimGlow;
// Opacity; outside the rounded shape the result is transparent (anti-aliased edge), so a drawable needs
// no clip.
uniform float alpha;

const half3 rgbToY = half3(0.2126, 0.7152, 0.0722);

float radiusAt(float2 coord, float4 radii) {
    if (coord.x >= 0.0) {
        if (coord.y <= 0.0) return radii.y;
        else return radii.z;
    } else {
        if (coord.y <= 0.0) return radii.x;
        else return radii.w;
    }
}

float sdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    float outside = length(max(cornerCoord, 0.0)) - radius;
    float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
    return outside + inside;
}

float safeSign(float value) {
    return value < 0.0 ? -1.0 : 1.0;
}

float2 safeNormalize(float2 value, float2 fallback) {
    float len = length(value);
    if (len > 0.001) {
        return value / len;
    }
    return fallback;
}

float2 gradSdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    if (cornerCoord.x >= 0.0 || cornerCoord.y >= 0.0) {
        float2 outside = max(cornerCoord, 0.0);
        float outsideLength = length(outside);
        if (outsideLength > 0.001) {
            return sign(coord) * (outside / outsideLength);
        }
        float useX = step(cornerCoord.y, cornerCoord.x);
        return float2(
            useX * safeSign(coord.x),
            (1.0 - useX) * safeSign(coord.y)
        );
    } else {
        float gradX = step(cornerCoord.y, cornerCoord.x);
        return sign(coord) * float2(gradX, 1.0 - gradX);
    }
}

// A smooth bump over [-0.8, 0.8]: one colour's share of the split.
half spectral(float x) {
    float u = clamp(1.0 - (x * x) / 0.64, 0.0, 1.0);
    return half(u * u);
}

float circleMap(float x) {
    return 1.0 - sqrt(1.0 - x * x);
}

half4 saturateColor(half4 color, float amount) {
    half3 lin = toLinearSrgb(color.rgb);
    float y = dot(lin, rgbToY);
    half3 gray = half3(y);
    half3 sat = fromLinearSrgb(mix(gray, lin, amount));
    return half4(sat, color.a);
}

half4 finish(half4 c, float2 centeredCoord, float2 halfSize, float radius, float sdRaw) {
    if (rimLight > 0.0 || rimGlow > 0.0) {
        float2 n = safeNormalize(gradSdRoundedRect(centeredCoord, halfSize, max(radius, 1.0)), float2(0.0, -1.0));
        float facing = dot(n, lightDir);
        float lobe = pow(max(facing, 0.0), 2.2) + 0.6 * pow(max(-facing, 0.0), 2.2) + 0.15;
        float edge = 1.0 - smoothstep(0.0, rimWidth, -sdRaw);
        float g = 1.0 - smoothstep(0.0, max(refractionHeight, 1.0), -sdRaw);
        float glow = rimGlow * g * g;
        c.rgb = min(c.rgb + half3((rimLight * edge + glow) * lobe), half3(1.0));
    }
    float m = clamp(0.5 - sdRaw, 0.0, 1.0) * alpha;
    return half4(c.rgb * m, c.a * m);
}

half4 main(float2 coord) {
    float2 halfSize = size * 0.5;
    float2 centeredCoord = (coord + offset) - halfSize;
    float radius = radiusAt(centeredCoord, cornerRadii);

    float sd = sdRoundedRect(centeredCoord, halfSize, radius);
    float sdRaw = sd;
    // Outside the shape (the margin recorded for outward refraction): clear, nothing to sample.
    if (sdRaw >= 0.5) return half4(0.0);
    if (-sd >= refractionHeight) {
        half4 baseColor = content.eval(coord);

        baseColor = saturateColor(baseColor, chromaMultiplier);
        float3 target = (whitePoint > 0.0) ? float3(1.0) : float3(0.0);
        baseColor.rgb = mix(baseColor.rgb, target, abs(whitePoint));
        baseColor.rgb = (baseColor.rgb - 0.5) * (1.0 + contrast) + 0.5;

        half3 tintedRGB = mix(baseColor.rgb, tintColor, tintAlpha);
        return finish(half4(tintedRGB, baseColor.a), centeredCoord, halfSize, radius, sdRaw);
    }

    sd = min(sd, 0.0);
    float x = clamp(1.0 - -sd / refractionHeight, 0.0, 1.0);
    float soft = x * x * x * (x * (x * 6.0 - 15.0) + 10.0);
    float d = mix(circleMap(x), soft, bandSoftness) * refractionAmount;
    float smoothRadius = max(radius * 1.5, 30.0);
    float gradRadius = min(smoothRadius, min(halfSize.x, halfSize.y));

    float2 shapeGrad = gradSdRoundedRect(centeredCoord, halfSize, gradRadius);
    float2 depthGrad = safeNormalize(centeredCoord, shapeGrad);
    float2 grad = safeNormalize(shapeGrad + depthEffect * depthGrad, shapeGrad);

    float2 refractedCoord = coord + d * grad;
    half4 color;
    if (chromaticAberration <= 0.0) {
        color = content.eval(refractedCoord);
    } else {
        // The colour split runs along the bend (the edge's normal) in proportion to it: strongest at the
        // rim, fading into the centre with the bend, the same all along an edge. Twelve taps with smooth,
        // overlapping spectral weights spread a sharp line into a smooth fringe instead of separate
        // coloured copies of it. The taps also spread along the edge (as far as the split is long, in a
        // shuffled order), so small details beyond the edge, which the bend stretches into streaks, blur
        // into one another instead of each turning into its own rainbow; shapes larger than the split
        // still get a clear fringe. The split also narrows toward the inside faster than the bend (x³, x =
        // 1 at the rim): a fringe that hugs the rim, as on Apple's glass, not a colour wash over the band.
        float splitLen = d * chromaticAberration * x * x * x;
        float2 split = grad * splitLen;
        float2 along = float2(-grad.y, grad.x) * splitLen;
        half3 acc = half3(0.0);
        half3 wsum = half3(0.0);
        half a = 0.0;
        for (int i = 0; i < 12; i++) {
            float t = (float(i) + 0.5) / 6.0 - 1.0;
            float u = fract(float(i) * 0.5833 + 0.04) * 2.0 - 1.0;
            half4 s = content.eval(refractedCoord + split * t + along * u);
            half3 w = half3(spectral(t - 0.55), spectral(t), spectral(t + 0.55));
            acc += s.rgb * w;
            wsum += w;
            a += s.a;
        }
        color = half4(acc / wsum, a / 12.0);
    }

    color = saturateColor(color, chromaMultiplier);
    float3 target = (whitePoint > 0.0) ? float3(1.0) : float3(0.0);
    color.rgb = mix(color.rgb, target, abs(whitePoint));
    color.rgb = (color.rgb - 0.5) * (1.0 + contrast) + 0.5;

    half3 tintedRGB = mix(color.rgb, tintColor, tintAlpha);
    return finish(half4(tintedRGB, color.a), centeredCoord, halfSize, radius, sdRaw);
}
